# Copie para .env e preencha. NUNCA comite o .env.
#
# REGRA DE OURO: use aspas simples em toda senha. Sem aspas, o dotenv trata
# '#' como início de comentário e trunca o valor silenciosamente — o app recebe
# uma senha curta e o erro aparece como "access denied", não como erro de parsing.

# ── ERP Voalle (Postgres, SOMENTE LEITURA — schema `erp`) ────────────
DB_ELLEVEN_HOST=
DB_ELLEVEN_PORT=5432
DB_ELLEVEN_DATABASE=
DB_ELLEVEN_USER=
DB_ELLEVEN_PASSWORD=''

# ── Data Hub (MariaDB) — base diária de clientes ─────────────────────
# IP privado: exige rede corporativa ou VPN
MARIA_HOST=
MARIA_PORT=3306
MARIA_DATABASE=DB_Applicattion
MARIA_USER=
MARIA_PASSWORD=''
MARIA_SSL=false
MARIA_POOL_MAX=5
MARIA_STATEMENT_TIMEOUT_MS=30000

# ── AutoISP (Postgres) — hoje inalcançável, ver P3 em docs/03-plano.md ─
DB_AUTOISP_HOST=
DB_AUTOISP_PORT=5432
DB_AUTOISP_DATABASE=
DB_AUTOISP_USER=
DB_AUTOISP_PASSWORD=''

# ── Postgres DA APLICAÇÃO — o único banco onde este sistema ESCREVE ──
#
# Guarda papéis, matriz de acesso por tela e a configuração do provedor de IA.
# NENHUM dado de negócio: indicador continua vindo do ERP ao vivo. Se este banco
# sumir, perde-se controle de acesso e IA, não se perde número.
#
# Todos os outros bancos são fontes de leitura de terceiros (o ERP recusa
# escrita, e gravar configuração nossa num banco de outra equipe transformaria
# nosso problema em manutenção deles).
#
# ⚠️ OPCIONAL POR DESENHO: sem DASH_HOST o dashboard funciona como antes do
# controle de acesso — todo mundo do domínio autorizado vê as 8 telas, e a tela
# de Configurações avisa que o controle está inativo. Falhar fechado aqui seria
# trocar "sem gestão de acesso" por "ninguém entra", o que é pior: a barreira que
# importa (autenticação) não depende deste banco.
#
# O esquema (schema `dash`, 4 tabelas) é criado sozinho na primeira consulta,
# com `CREATE ... IF NOT EXISTS`. Não há passo de migração manual. O usuário
# precisa de permissão para criar schema no banco apontado.
DASH_HOST=
DASH_PORT=5432
DASH_DATABASE=dash
DASH_USER=dash
DASH_PASSWORD=''
DASH_POOL_MAX=4

# Administradores definidos no AMBIENTE, que a tela não pode rebaixar.
#
# É a porta de emergência do controle de acesso: sem ninguém admin, ninguém abre
# Configurações, e sem Configurações ninguém vira admin. Também é a saída se
# alguém se rebaixar por engano. Aceita vários, separados por vírgula.
ADMIN_EMAILS=

# ── SSO — Firebase Authentication (conta Google da Sebratel) ─────────
#
# SEM ESTAS VARIÁVEIS O DASHBOARD NÃO ABRE: o middleware responde 503. É falha
# fechada de propósito — erro de configuração não pode virar exposição
# silenciosa.
#
# Onde achar: console do Firebase → Configurações do projeto → Seus aplicativos
# → app da Web → Configuração do SDK.
#
# ⚠️ PROJETO PRÓPRIO DESTE SISTEMA (`maintenance-dashboard-bbf92`). Não
# reaproveite o projeto Firebase de outro setor, mesmo sendo a mesma empresa e
# o mesmo domínio de e-mail: base de usuários, domínios autorizados, cotas e log
# de acesso ficam separados, e comprometer um sistema não alcança os outros.
#
# Estes quatro valores NÃO são segredo — vão para o navegador por desenho. Não
# os trate como senha, mas também não os commite: este arquivo é a receita de
# recuperação, o `.env` é que guarda os valores.
#
# Eles são lidos em TEMPO DE EXECUÇÃO (o servidor passa a configuração para a
# tela de login), então trocar de projeto Firebase exige recriar o container e
# NÃO exige reconstruir a imagem.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# ⚠️ DOIS PASSOS MANUAIS NO CONSOLE, que nenhum build acusa:
#   1. Authentication → Sign-in method → Google → Ativar.
#      Projeto novo vem com todos os provedores desligados.
#   2. Authentication → Settings → Authorized domains → adicionar o domínio
#      onde o dashboard roda. Só `localhost` vem liberado de fábrica; sem isso
#      o popup falha com `auth/unauthorized-domain` no primeiro clique real.
#
# ⚠️ RESTRINJA A CHAVE no Google Cloud → APIs e serviços → Credenciais:
#   - Restrições de API: só Identity Toolkit e Token Service;
#   - Restrições de aplicativo: referenciadores HTTP do domínio do dashboard.
#   Chave habilitada para API cobrada (Gemini, Maps) publicada no bundle é
#   cartão de crédito aberto.

# ── Redis (cache L2) — OPCIONAL ──────────────────────────────────────
# Sem REDIS_HOST o app funciona igual: o cache L1 em memória continua fazendo
# todo o trabalho. O Redis só faz o dado SOBREVIVER ao redeploy (e ser
# compartilhado, se um dia houver mais de um container).
#
# ⚠️ ESTE REDIS É COMPARTILHADO com as outras aplicações do servidor. Por isso:
#   - toda chave leva o prefixo REDIS_PREFIXO;
#   - toda chave tem TTL (nada fica sem expiração);
#   - só entra payload até REDIS_MAX_KB, para não disputar memória com as
#     outras apps (um grid de /protocolos serializado tem ~50 MB).
# Nunca rodar KEYS/FLUSHDB/FLUSHALL contra ele: apagaria dado alheio.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=''
REDIS_DB=0
REDIS_PREFIXO=dash:manutencao:
REDIS_MAX_KB=512
REDIS_TIMEOUT_MS=200

# ── Aplicação ────────────────────────────────────────────────────────
PORT=3000

# Teto de memória do cache L1, em MB (ver src/server/cache.ts).
# 256 deixa folga dentro do heap de 1 GB usado no deploy.
CACHE_MAX_MB=256

# Domínio de e-mail aceito no login. É ELE quem controla acesso: o `hd` que a
# tela manda ao Google só filtra o seletor de contas, e um token legítimo de
# conta pessoal chega aqui igual. Obrigatório — sem ele o dashboard dá 503.
ALLOWED_DOMAIN=sebratel.com.br

# ADMIN_EMAILS está junto do banco da aplicação, mais acima — é lá que ele faz
# sentido, ao lado do que ele destrava.
DATA_INICIO_HISTORICO=2025-01-01
